require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'json'
require 'xcodeproj' # Import the tool to edit Xcode projects

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
prepare_react_native_project!

target 'MyCommute' do
  use_expo_modules!
  
  config = use_native_modules!
  
  # Firebase fix
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  post_install do |installer|
    # 1. Standard React Native Fixes
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # 2. Fix Pods Targets (Compiler Settings)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
    end

    # 3. CRITICAL FIX: Open User Project and Force Widget Paths
    # This edits MyCommute.xcodeproj directly to fix the missing RCTTurboModule.h
    puts "🔧 Fixing Widget Extension Search Paths..."
    
    project_path = File.join(File.dirname(__FILE__), 'MyCommute.xcodeproj')
    project = Xcodeproj::Project.open(project_path)
    
    # Find your Widget Target
    widget_target = project.targets.find { |t| t.name == 'CommuteWidgetExtension' }
    
    if widget_target
      puts "✅ Found target: CommuteWidgetExtension"
      widget_target.build_configurations.each do |config|
        # Ensure HEADER_SEARCH_PATHS exists
        config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited) '
        
        # Add the specific React Native header paths
        # This tells the Widget exactly where to find the missing file
        extra_paths = [
          '"${PODS_ROOT}/Headers/Public"',
          '"${PODS_ROOT}/Headers/Public/React-Core"',
          '"${PODS_ROOT}/Headers/Public/ReactCommon"',
          '"${PODS_ROOT}/Headers/Public/React-cxxreact"',
          '"${PODS_ROOT}/Headers/Public/React-callinvoker"'
        ]
        
        # Append only if not already present
        extra_paths.each do |path|
          unless config.build_settings['HEADER_SEARCH_PATHS'].include?(path)
            config.build_settings['HEADER_SEARCH_PATHS'] << " #{path}"
          end
        end
      end
      project.save
      puts "💾 Saved Search Paths to MyCommute.xcodeproj"
    else
      puts "⚠️ Warning: Could not find CommuteWidgetExtension target!"
    end
  end
end

target 'CommuteWidgetExtension' do
  inherit! :search_paths
end