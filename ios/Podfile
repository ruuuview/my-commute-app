require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'json'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
prepare_react_native_project!

target 'MyCommute' do
  use_expo_modules!
  
  config = use_native_modules!
  
  # Firebase fix
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  post_install do |installer|
    # 1. Standard React Native Fixes
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # 2. Define the path to React Native in node_modules
    # We use this to force the widget to look here
    react_native_node_modules_path = File.expand_path("../node_modules/react-native", __dir__)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Compiler Settings
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        
        # 3. ABSOLUTE PATH FIX FOR WIDGET
        # We target the Pods wrapper for the widget
        if target.name == 'Pods-CommuteWidgetExtension'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited) '
          
          # Force lookups directly in node_modules
          # This bypasses CocoaPods' header copying entirely
          search_paths = [
            "\"#{react_native_node_modules_path}\"",
            "\"#{react_native_node_modules_path}/ReactCommon\"",
            "\"#{react_native_node_modules_path}/React\"",
            "\"#{react_native_node_modules_path}/React/Base\""
          ]
          
          config.build_settings['HEADER_SEARCH_PATHS'] << ' ' + search_paths.join(' ')
        end
      end
    end
  end
end

target 'CommuteWidgetExtension' do
  inherit! :search_paths
end