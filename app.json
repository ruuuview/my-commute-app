{
  "expo": {
    "name": "My Commute",
    "slug": "my-commute",
    "version": "1.0.45",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mycommute",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "appleTeamId": "PM83YLJ8T9",
      "buildNumber": "725",
      "supportsTablet": true,
      "bundleIdentifier": "com.mycommute.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "location",
          "remote-notification"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow My Commute to use your location in the background to detect station arrival and automate delay repay.",
        "NSLocationAlwaysUsageDescription": "Allow My Commute to use your location in the background to detect station arrival and automate delay repay.",
        "NSLocationWhenInUseUsageDescription": "Allow My Commute to use your location to show nearby stations and departures.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "citymapper",
          "tfl-go"
        ],
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mycommute.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.mycommute.app",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "We read departure times alongside your calendar — all on your device. Nothing leaves your phone."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "./plugins/withFmtCpp17",
      "@bacons/apple-targets",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0098D4"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow My Commute to use your location in the background to detect station arrival and automate delay repay.",
          "locationAlwaysPermission": "Allow My Commute to use your location in the background to detect station arrival and automate delay repay.",
          "locationWhenInUsePermission": "Allow My Commute to use your location to show nearby stations and departures.",
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.mycommute.app.MyCommuteWidget",
                  "targetName": "MyCommuteWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mycommute.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1efee0b5-6e68-4c91-830a-fde4f951c1f0"
      }
    },
    "owner": "rudrakay"
  }
}
