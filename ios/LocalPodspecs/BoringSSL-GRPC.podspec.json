{
  "name": "BoringSSL-GRPC",
  "version": "0.0.24",
  "summary": "BoringSSL is a fork of OpenSSL (patched locally to remove -G flag)",
  "homepage": "https://github.com/google/boringssl",
  "license": { "type": "Mixed", "file": "LICENSE" },
  "authors": "Google Inc.",
  "source": {
    "git": "https://github.com/google/boringssl.git",
    "commit": "b9232f9e27e5668bc0414879dcdedb2a59ea75f2"
  },
  "platforms": {
    "ios": "10.0"
  },
  "prepare_command": "find . -name '*.S' -type f -exec sed -i '' 's/-G//g' {} +",
  "module_name": "openssl_grpc",
  "pod_target_xcconfig": {
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) COCOAPODS=1",
    "OTHER_CFLAGS": "$(inherited)",
    "HEADER_SEARCH_PATHS": "$(inherited) \"${PODS_TARGET_SRCROOT}/src/include\""
  },
  "preserve_paths": [
    "src/include/openssl/*.h",
    "src/ssl/*.h"
  ],
  "source_files": [
    "src/ssl/**/*.{h,c,cc}",
    "src/crypto/**/*.{h,c,cc}",
    "src/include/openssl/*.h"
  ],
  "exclude_files": "**/*_test.{h,c,cc}",
  "header_mappings_dir": "src/include",
  "libraries": "c++",
  "compiler_flags": "-DBORINGSSL_PREFIX=GRPC"
}
