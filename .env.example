# ── Sentry (Error Monitoring) ──────────────────────────────────
# Free tier: 5,000 events/month across projects
# Get: https://sentry.io → create React Native project → copy DSN
EXPO_PUBLIC_SENTRY_DSN=

# ── GrowthBook (Feature Flags) ────────────────────────────────
# Free tier: unlimited flags, 3 users, 10k requests/month
# Get: https://growthbook.io → create project → SDK Connection → Client Key
EXPO_PUBLIC_GROWTHBOOK_API_HOST=https://cdn.growthbook.io
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# ── TfL OAuth (Phase 1 — return-state routing) ─────────────────
# Set these to activate the ASWebAuthenticationSession flow. Until set,
# "File Claim on TfL" falls back to opening the plain TfL Delay Repay page
# (origin tracking + callback routing still work either way).
# Register the redirect URI EXACTLY as: mycommute://auth/callback
EXPO_PUBLIC_TFL_OAUTH_AUTH_URL=
EXPO_PUBLIC_TFL_OAUTH_CLIENT_ID=

# ── Demo Mode (Phase 7) ───────────────────────────────────────
# true → zero Refund Radar UI surface in the build (nav item, dashboard
# card, deep links all gated).
EXPO_PUBLIC_DEMO_MODE=false

# ── Product Analytics (Phase 7) ───────────────────────────────
# Events (permission_requested/granted/denied, permission_upgrade_primer_shown)
# emit to Sentry breadcrumbs + dev console today. Set a PostHog project key
# to forward to PostHog.
EXPO_PUBLIC_POSTHOG_KEY=
