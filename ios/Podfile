require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'fileutils'
require 'json'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
prepare_react_native_project!

target 'MyCommute' do
  use_expo_modules!
  config = use_native_modules!

  # --- FIREBASE MODULES ---
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # 1. INJECTION FIX
    rn_root = File.expand_path("../node_modules/react-native", __dir__)
    source_file = Dir.glob("#{rn_root}/**/RCTTurboModule.h").first
    if source_file
      dest_dir = File.join(installer.sandbox.root, "Headers/Public/ReactCommon")
      FileUtils.mkdir_p(dest_dir)
      FileUtils.cp(source_file, dest_dir)
    end

    # 2. RUBY C++ PATCH
    puts "🩹 Applying C++ patches..."
    header_files = Dir.glob("Pods/**/*.{h,hpp}")
    header_files.each do |file_path|
      begin
        content = File.read(file_path)
        original_content = content.dup
        content.gsub!(/std::result_of/, 'std::invoke_result')
        content.gsub!(/std::invoke_result<F\(\)>/, 'std::invoke_result<F>')
        content.gsub!(/Traits::template CallSeqFactory\(/, 'Traits::template CallSeqFactory<>(')
        if content != original_content
          File.write(file_path, content)
        end
      rescue; end
    end

    # 3. ULTIMATE -G FLAG DESTROYER
    puts "🔥 FINAL ASSAULT ON -G FLAGS..."
    
    # Patch ALL possible locations for .xcconfig files
    [
      "Pods/Target Support Files/**/*.xcconfig",
      "Pods/**/*.xcconfig", 
      "Pods/**/Pods-*.*.xcconfig"
    ].each do |pattern|
      Dir.glob(pattern).each do |file|
        begin
          content = File.read(file)
          original = content.dup
          
          # Remove -G with various spacing
          content.gsub!(/ -G /, ' ')
          content.gsub!(/^-G /, '')
          content.gsub!(/ -G$/, '')
          content.gsub!(/"-G"/, '')
          content.gsub!(/\s-G\s/, ' ')
          
          if content != original
            File.write(file, content)
            puts "   ✅ Cleaned: #{File.basename(file)}"
          end
        rescue => e
          # Skip files we can't read
        end
      end
    end

    # 4. Patch project.pbxproj directly (The Classic Fix)
    project_path = File.join(installer.pods_project.path, 'project.pbxproj')
    if File.exist?(project_path)
      content = File.read(project_path)
      original = content.dup
      
      content.gsub!(/ -G /, ' ')
      content.gsub!(/"-G"/, '')
      content.gsub!(/"-G",/, '')
      content.gsub!(/, "-G"/, '')
      
      if content != original
        File.write(project_path, content)
        puts "   ✅ Cleaned: project.pbxproj"
      end
    end

    # 5. STANDARD BUILD CONFIGURATIONS & OTHER_CFLAGS SCRUBBER
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << '_LIBCPP_ENABLE_CXX20_REMOVED_TYPE_TRAITS=1'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        
        # Remove -G from OTHER_CFLAGS if it exists (This is the new key check)
        if config.build_settings['OTHER_CFLAGS']
          if config.build_settings['OTHER_CFLAGS'].is_a?(String)
            config.build_settings['OTHER_CFLAGS'] = config.build_settings['OTHER_CFLAGS'].gsub('-G', '').strip
          elsif config.build_settings['OTHER_CFLAGS'].is_a?(Array)
            config.build_settings['OTHER_CFLAGS'].delete('-G')
          end
        end
      end
    end
    
    puts "✅ -G FLAG DESTRUCTION COMPLETE"
  end
end

target 'CommuteWidgetExtension' do
  # Keep empty
end