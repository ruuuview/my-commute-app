require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'fileutils'
require 'json'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
prepare_react_native_project!

target 'MyCommute' do
  use_expo_modules!
  config = use_native_modules!

  # --------------------------------------------------------
  # 🔒 FORCE STABLE GRPC VERSIONS
  # We pin this to 1.62.2 to avoid the "Bleeding Edge" 
  # BoringSSL versions that introduced the -G flag.
  # --------------------------------------------------------
  pod 'gRPC-Core', '1.62.2', :modular_headers => true
  pod 'gRPC-C++', '1.62.2', :modular_headers => true

  # --- FIREBASE MODULES ---
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    puts "🔧 POST-INSTALL PATCHES..."

    # 1. INJECTION FIX
    rn_root = File.expand_path("../node_modules/react-native", __dir__)
    source_file = Dir.glob("#{rn_root}/**/RCTTurboModule.h").first
    if source_file
      dest_dir = File.join(installer.sandbox.root, "Headers/Public/ReactCommon")
      FileUtils.mkdir_p(dest_dir)
      FileUtils.cp(source_file, dest_dir)
      puts "   ✅ Copied RCTTurboModule.h"
    end

    # 2. C++ PATCHES
    header_files = Dir.glob("Pods/**/*.{h,hpp}")
    header_files.each do |file_path|
      begin
        content = File.read(file_path)
        original_content = content.dup
        content.gsub!(/std::result_of/, 'std::invoke_result')
        content.gsub!(/std::invoke_result<F\(\)>/, 'std::invoke_result<F>')
        content.gsub!(/Traits::template CallSeqFactory\(/, 'Traits::template CallSeqFactory<>(')
        if content != original_content
          File.write(file_path, content)
        end
      rescue; end
    end

    # 3. PATCH BORINGSSL ASSEMBLY FILES (The -G Killer)
    puts "🔥 Patching BoringSSL assembly files..."
    Dir.glob("Pods/BoringSSL-GRPC/**/*.{S,s}").each do |asm_file|
      begin
        content = File.read(asm_file)
        if content.include?('-G')
          # Be careful to only remove the flag, not other code
          content.gsub!(/ -G /, ' ')
          content.gsub!(/-G /, '')
          content.gsub!(/ -G$/, '')
          File.write(asm_file, content)
          puts "   ✅ Patched assembly: #{File.basename(asm_file)}"
        end
      rescue; end
    end

    # 4. REMOVE -G FROM BUILD SETTINGS
    installer.pods_project.targets.each do |target|
      # A. Specific BoringSSL Targeting
      if target.name.include?('BoringSSL')
        target.build_configurations.each do |config|
          ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'WARNING_CFLAGS'].each do |key|
            if config.build_settings[key]
              if config.build_settings[key].is_a?(Array)
                config.build_settings[key].delete('-G')
                config.build_settings[key].delete_if { |f| f.strip == '-G' }
              elsif config.build_settings[key].is_a?(String)
                config.build_settings[key] = config.build_settings[key].gsub(/-G\b/, '').strip
              end
            end
          end
        end
      end
      
      # B. Standard Settings for ALL targets
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << '_LIBCPP_ENABLE_CXX20_REMOVED_TYPE_TRAITS=1'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      end
    end
    puts "✅ POST-INSTALL COMPLETE"
  end
end

target 'CommuteWidgetExtension' do
  # Keep empty
end