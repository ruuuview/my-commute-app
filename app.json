{
  "expo": {
    "name": "My Commute",
    "slug": "my-commute", //
    "version": "1.0.0",    //
    "orientation": "portrait",
    // ...
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-font",
      "expo-web-browser",
      //
      //
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static" //
          }
        }
      ]
    ],
    // ... rest of the file ...
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_BACKEND_URL": "https://tube-notifier.preview.emergentagent.com",
      "router": {},
      "eas": {
        "projectId": "e858f07f-d13c-4639-80fc-054534497d1f"
      }
    }
  }
}
