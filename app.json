{
  "expo": {
    "name": "My Commute",
    // ... all other configuration ...

    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-font",
      "expo-web-browser",
      // CRITICAL FIX: The entire plugin must be inside the array,
      // with the options passed as the second element.
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static" // This is the line that fixes the Pod conflict
          }
        }
      ]
    ],
    // ... rest of the file ...
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_BACKEND_URL": "https://tube-notifier.preview.emergentagent.com",
      "router": {},
      "eas": {
        "projectId": "e858f07f-d13c-4639-80fc-054534497d1f"
      }
    }
  }
}
