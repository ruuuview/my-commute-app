require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'json'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
prepare_react_native_project!

target 'MyCommute' do
  use_expo_modules!
  
  config = use_native_modules!
  
  # Firebase Dependency Fix
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  post_install do |installer|
    # 1. Standard React Native Fixes
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # 2. General Compiler Fixes
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        
        # 3. CRITICAL WIDGET FIX
        # We target "Pods-CommuteWidgetExtension" because that is the name CocoaPods uses.
        # This pushes the React headers into the Widget's build configuration.
        if target.name == 'Pods-CommuteWidgetExtension'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited) '
          
          # Add every possible path for React headers
          extra_paths = [
            '"${PODS_ROOT}/Headers/Public"',
            '"${PODS_ROOT}/Headers/Public/React-Core"',
            '"${PODS_ROOT}/Headers/Public/ReactCommon"',
            '"${PODS_ROOT}/Headers/Public/React-cxxreact"',
            '"${PODS_ROOT}/Headers/Public/React-callinvoker"',
            '"${PODS_ROOT}/Headers/Public/Yoga"',
            '"${PODS_CONFIGURATION_BUILD_DIR}/React-Core/React_Core.framework/Headers"'
          ]
          
          config.build_settings['HEADER_SEARCH_PATHS'] << ' ' + extra_paths.join(' ')
        end
      end
    end
  end
end

target 'CommuteWidgetExtension' do
  inherit! :search_paths
end