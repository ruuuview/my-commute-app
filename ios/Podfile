require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'json'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
prepare_react_native_project!

# --- HELPER FUNCTION: FIND THE MISSING HEADER ---
def find_header_path
  # Search node_modules for the elusive file
  # This runs on the EAS server during 'pod install'
  puts "🔍 Hunting for RCTTurboModule.h..."
  rn_root = File.expand_path("../node_modules/react-native", __dir__)
  found_file = Dir.glob("#{rn_root}/**/RCTTurboModule.h").first
  
  if found_file
    # Return the directory containing the file
    dir = File.dirname(found_file)
    puts "✅ Found Header at: #{dir}"
    return dir
  else
    puts "⚠️ Could not find RCTTurboModule.h"
    return nil
  end
end

target 'MyCommute' do
  use_expo_modules!
  config = use_native_modules!
  
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # 1. Get the absolute path using the helper above
    header_path = find_header_path()

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        
        # 2. Inject the path into the Widget Target
        if target.name == 'Pods-CommuteWidgetExtension'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited) '
          
          # Add the specific folder we found
          if header_path
             config.build_settings['HEADER_SEARCH_PATHS'] << " \"#{header_path}\""
          end
          
          # Also add the standard ReactCommon folder just in case
          config.build_settings['HEADER_SEARCH_PATHS'] << " \"${PODS_ROOT}/Headers/Private/React-Core\""
        end
      end
    end
  end
end

target 'CommuteWidgetExtension' do
  # We revert to inheriting because isolation failed
  inherit! :search_paths
end