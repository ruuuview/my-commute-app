require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'fileutils'
require 'json'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'MyCommute' do
  use_expo_modules!
  use_modular_headers!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'npx',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)
  
  # 1. CORE DEPENDENCIES
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'

  # 2. LOCAL C++ STACK
  pod 'fmt', :podspec => '../node_modules/react-native/third-party-podspecs/fmt.podspec', :modular_headers => true
  
  # --- FIX: DISABLE MODULES FOR CONFLICTING LIBS ---
  pod 'React-jsitooling', :modular_headers => false
  pod 'React-runtime', :modular_headers => false
  pod 'React-cxxreact', :modular_headers => false
  pod 'React-jsi', :modular_headers => false
  pod 'React-jsiexecutor', :modular_headers => false
  
  # C++ libs must be NON-MODULAR
  pod 'RCT-Folly', :podspec => '../node_modules/react-native/third-party-podspecs/RCT-Folly.podspec', :modular_headers => false
  pod 'fast_float', :podspec => '../node_modules/react-native/third-party-podspecs/fast_float.podspec', :modular_headers => false
  pod 'DoubleConversion', :podspec => '../node_modules/react-native/third-party-podspecs/DoubleConversion.podspec', :modular_headers => false
  pod 'glog', :podspec => '../node_modules/react-native/third-party-podspecs/glog.podspec', :modular_headers => false

  # 3. HYBRID FIX FOR BORINGSSL & gRPC
  pod 'gRPC-Core', :modular_headers => false
  pod 'gRPC-C++', :modular_headers => false
  pod 'BoringSSL-GRPC', :modular_headers => false

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    puts "🧹 Applying Final Survival Patches..."

    # 4. COMPILER FLAGS
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |flag_name|
        if config.build_settings[flag_name].is_a?(String)
           config.build_settings[flag_name] = config.build_settings[flag_name].gsub(/-G\s*[0-9]*/, '').strip
        end
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['WARNING_CFLAGS'] = '-w -Wno-error=incompatible-function-pointer-types -Wno-error=implicit-function-declaration -Wno-error=int-conversion'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'

        if target.name.include?('BoringSSL')
           safe_flags = '-DOPENSSL_NO_ASM -w -fno-objc-arc'
           config.build_settings['OTHER_CFLAGS'] = safe_flags
           config.build_settings['OTHER_CPLUSPLUSFLAGS'] = safe_flags
           config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0' 
           config.build_settings['GCC_GENERATE_DEBUGGING_SYMBOLS'] = 'NO'
        end
      end
    end

    # 5. ABSOLUTE PATH SHIM (Required for React Native 0.81)
    puts "🔍 Hunting for RCTTurboModule.h..."
    rn_root = File.expand_path("../node_modules/react-native", __dir__)
    found = Dir.glob("#{rn_root}/**/RCTTurboModule.h").first
    
    if found
        bridge_content = "#include \"#{found}\"\n"
        ["Public", "Private"].each do |access|
            ["ReactCommon", "React"].each do |sub|
                shim_dir = "Pods/Headers/#{access}/#{sub}"
                if Dir.exist?("Pods")
                    FileUtils.mkdir_p(shim_dir)
                    File.write("#{shim_dir}/RCTTurboModule.h", bridge_content)
                end
            end
        end
        puts "✅ Bridge built for RCTTurboModule.h"
    end

    # 6. FOLLY SHIM (UPDATED WITH MISSING TYPES)
    folly_sync_dir = "Pods/RCT-Folly/folly/synchronization"
    FileUtils.mkdir_p(folly_sync_dir)
    header_path = "#{folly_sync_dir}/SanitizeThread.h"
    
    if File.exist?(header_path)
      File.chmod(0644, header_path) rescue nil
      File.delete(header_path) rescue nil
    end

    # The corrected shim content with typedefs
    shim_content = <<~HEREDOC
      /* Shim */
      #pragma once
      #include <folly/Portability.h>
      
      // Fix for unknown type names
      typedef void (*annotate_rwlock_cd_t)(const volatile void *, const char *, int);
      typedef void (*annotate_rwlock_ar_t)(const volatile void *, const char *, int);
      typedef void (*annotate_benign_race_sized_t)(const volatile void *, long, const char *, int);
      typedef void (*annotate_ignore_t)(const char *, int);

      namespace folly { 
        namespace detail { 
          extern void* const annotate_rwlock_create_v; 
        } 
        static void annotate_rwlock_create(void const volatile* const addr, char const* const f, int const l) {} 
        class annotate_ignore_thread_sanitizer_guard { 
        public: 
          annotate_ignore_thread_sanitizer_guard(const char* f, int l) {} 
          ~annotate_ignore_thread_sanitizer_guard() {} 
        }; 
      }
    HEREDOC
    
    File.write(header_path, shim_content)

    # 7. SOURCE PATCHES
    puts "🔧 Patching Sources..."
    system("LC_ALL=C find Pods -type f -name 'basic_seq.h' -exec sed -i '' 's/Traits::template CallSeqFactory(/Traits::template CallSeqFactory<>(/g' {} +")
    system("LC_ALL=C find Pods -type f -name 'promise_like.h' -exec sed -i '' 's/std::result_of<F()>/std::invoke_result<F>/g' {} +")
    system("LC_ALL=C find Pods -type f -name 'promise_like.h' -exec sed -i '' 's/std::result_of/std::invoke_result/g' {} +")
    system("LC_ALL=C find Pods -type f -name 'ThreadId.cpp' -exec sed -i '' 's/#include <folly\\/synchronization\\/RelaxedAtomic.h>/#include <atomic>/g' {} +")
    system("LC_ALL=C find Pods -type f -name 'ThreadId.cpp' -exec sed -i '' 's/relaxed_atomic/std::atomic/g' {} +")
    system("LC_ALL=C find Pods/boost -type f -name '*.hpp' -exec sed -i '' 's/std::unary_function/std::__unary_function/g' {} +")
    system("LC_ALL=C find Pods/boost -type f -name '*.hpp' -exec sed -i '' 's/std::binary_function/std::__binary_function/g' {} +")
    system("LC_ALL=C find Pods/boost -type f -name '*.hpp' -exec sed -i '' 's/std::auto_ptr/std::unique_ptr/g' {} +")

    # 8. FIX JS CALL INVOKER (Modern Fix)
    puts "⚡️ Patching Worklets.mm..."
    worklets_files = Dir.glob("Pods/**/Worklets.mm")
    worklets_files.each do |file|
        content = File.read(file)
        unless content.include?("RCTBridgeJSCallInvoker.h")
            content.gsub!('#import <React/RCTBridge.h>', "#import <React/RCTBridge.h>\n#import <ReactCommon/RCTBridgeJSCallInvoker.h>")
        end
        content.gsub!(/\[(_?bridge) jsCallInvoker\]/, 'facebook::react::RCTBridgeJSCallInvoker(\1)')
        File.write(file, content)
    end
  end
end

target 'CommuteWidget' do
  use_frameworks! :linkage => :static
end